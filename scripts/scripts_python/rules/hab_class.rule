rule hab_class_cv:
    input:
        micro_table = output_folder + "/" + input_name + "/micro_vars/reduced_{tax_level}.csv",
        meta = config["mfd_metadata"],
    output:
        model_object = output_folder + "/" + output_name + "/model_{tax_level}_{hab_level}.RData",
    params:
        n_samples = config["hab_n_samples"],
    conda:
        env_folder + "/hab_class_r_packages.yml"
    resources:
        runtime = "0-06:00:00",
        mem_mb = "100G",
        partition = "general",
        threads = 25,
    threads:
        25
    shell:
        """
        mkdir -p "{output_folder}/{output_name}"
        scripts/scripts_R/hab_rand_forest_classifier.R --input_table {input.micro_table} --out_object {output.model_object} --meta {input.meta} --class {wildcards.hab_level} --n_obs {params.n_samples} --threads {threads}
        """





